# ---- Google OAuth (Google Cloud Console で作成した「ウェブアプリケーション」クライアント) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# /api/auth/google?secret=ADMIN_SECRET で連携した後に表示されるリフレッシュトークンを貼り付け
GOOGLE_REFRESH_TOKEN=

# 公開URL（OAuthリダイレクトとキャンセルリンクに使用）
APP_URL=http://localhost:3000

# 管理画面のパスワード（未設定なら ADMIN_SECRET がパスワードになります）
ADMIN_PASSWORD=

# 管理用シークレット（Google連携ページの保護・キャンセルリンク署名に使用）。長いランダム文字列に。
ADMIN_SECRET=change-me-to-a-long-random-string

# Google未設定でもデモ動作させる場合は 1（予定はメモリ上に保存）
MOCK_GOOGLE=1

# ---- Supabase（設定・予約記録の保存先: mambalike-app） ----
SUPABASE_URL=https://pintpaaaivczqmmrmqqq.supabase.co
# Supabase管理画面 → Project Settings → API Keys の「secret key」（sb_secret_...）または service_role キー。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=

# ---- LINE通知（LINE公式アカウント → Messaging API） ----
# LINE Developers のチャネル → 「チャネル基本設定」のチャネルシークレット
LINE_CHANNEL_SECRET=
# 「Messaging API設定」のチャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
