# ---- Google OAuth (Google Cloud Console で作成した「ウェブアプリケーション」クライアント) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# /api/auth/google?secret=ADMIN_SECRET で連携した後に表示されるリフレッシュトークンを貼り付け
GOOGLE_REFRESH_TOKEN=

# 公開URL（OAuthリダイレクトとキャンセルリンクに使用）
APP_URL=http://localhost:3000

# 管理画面のパスワード（未設定なら ADMIN_SECRET がパスワードになります）
ADMIN_PASSWORD=

# 管理用シークレット（Google連携ページの保護・キャンセルリンク署名に使用）。長いランダム文字列に。
ADMIN_SECRET=change-me-to-a-long-random-string

# Google未設定でもデモ動作させる場合は 1（予定はメモリ上に保存）
MOCK_GOOGLE=1
